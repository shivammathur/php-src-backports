From 17b034498a86cee8a34a9a2afae2eafa083a38da Mon Sep 17 00:00:00 2001
From: Shivam Mathur <shivam_jpr@hotmail.com>
Date: Tue, 24 Nov 2026 15:36:59 +0530
Subject: [PATCH] Restrict SOAP element lookups to XML element nodes


diff --git a/ext/soap/php_xml.c b/ext/soap/php_xml.c
index 11f8b5f6a4..1063450d28 100644
--- a/ext/soap/php_xml.c
+++ b/ext/soap/php_xml.c
@@ -275,6 +275,10 @@ int attr_is_equal_ex(xmlAttrPtr node, char *name, char *ns)
 
 int node_is_equal_ex(xmlNodePtr node, char *name, char *ns)
 {
+	if (node->type != XML_ELEMENT_NODE) {
+		return FALSE;
+	}
+
 	if (name == NULL || ((node->name) && strcmp((char*)node->name, name) == 0)) {
 		if (ns) {
 			xmlNsPtr nsPtr = node_find_ns(node);
diff --git a/ext/soap/tests/wsdl_document_element.phpt b/ext/soap/tests/wsdl_document_element.phpt
new file mode 100644
index 0000000000..31bd69747e
--- /dev/null
+++ b/ext/soap/tests/wsdl_document_element.phpt
@@ -0,0 +1,15 @@
+--TEST--
+SOAP loads the document element of a WSDL and imported schema with document types
+--SKIPIF--
+<?php if (!extension_loaded("soap")) die("skip soap extension required"); ?>
+--INI--
+soap.wsdl_cache_enabled=0
+--FILE--
+<?php
+$client = new SoapClient(__DIR__ . "/wsdl_document_element.wsdl");
+echo implode("\n", $client->__getTypes()), "\n";
+?>
+--EXPECT--
+struct Record {
+ string value;
+}
diff --git a/ext/soap/tests/wsdl_document_element.wsdl b/ext/soap/tests/wsdl_document_element.wsdl
new file mode 100644
index 0000000000..6bce4e765d
--- /dev/null
+++ b/ext/soap/tests/wsdl_document_element.wsdl
@@ -0,0 +1,17 @@
+<?xml version="1.0"?>
+<!DOCTYPE definitions>
+<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:tns="urn:service"
+    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" targetNamespace="urn:service">
+  <types>
+    <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:service">
+      <import namespace="urn:types" schemaLocation="wsdl_document_element.xsd"/>
+    </schema>
+  </types>
+  <portType name="PortType"/>
+  <binding name="Binding" type="tns:PortType">
+    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
+  </binding>
+  <service name="Service">
+    <port name="Port" binding="tns:Binding"><soap:address location="http://example.invalid/"/></port>
+  </service>
+</definitions>
diff --git a/ext/soap/tests/wsdl_document_element.xsd b/ext/soap/tests/wsdl_document_element.xsd
new file mode 100644
index 0000000000..fea056921d
--- /dev/null
+++ b/ext/soap/tests/wsdl_document_element.xsd
@@ -0,0 +1,7 @@
+<?xml version="1.0"?>
+<!DOCTYPE schema>
+<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:types">
+  <complexType name="Record">
+    <sequence><element name="value" type="string"/></sequence>
+  </complexType>
+</schema>
