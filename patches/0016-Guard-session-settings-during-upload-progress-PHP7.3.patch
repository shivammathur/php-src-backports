From 9925d057893c02e39e1f946a74efe35a6ca51b3f Mon Sep 17 00:00:00 2001
From: Shivam Mathur <shivam_jpr@hotmail.com>
Date: Tue, 24 Nov 2026 15:36:57 +0530
Subject: [PATCH] Guard runtime session settings when upload progress is
 enabled


diff --git a/ext/session/session.c b/ext/session/session.c
index 0a4ca6eeda..6aab385ffe 100644
--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -86,6 +86,12 @@ zend_class_entry *php_session_update_timestamp_iface_entry;
 #define IF_SESSION_VARS() \
 	if (Z_ISREF_P(&PS(http_session_vars)) && Z_TYPE_P(Z_REFVAL(PS(http_session_vars))) == IS_ARRAY)
 
+#define SESSION_CHECK_UPLOAD_PROGRESS_STATE \
+	if (PS(rfc1867_enabled) && stage == ZEND_INI_STAGE_RUNTIME) { \
+		zend_throw_error(NULL, "Session ini settings cannot be changed at runtime when session.upload_progress.enabled is On"); \
+		return FAILURE; \
+	}
+
 #define SESSION_CHECK_ACTIVE_STATE	\
 	if (PS(session_status) == php_session_active) {	\
 		php_error_docref(NULL, E_WARNING, "A session is active. You cannot change the session module's ini settings at this time");	\
@@ -533,6 +539,7 @@ static PHP_INI_MH(OnUpdateSaveHandler) /* {{{ */
 {
 	const ps_module *tmp;
 
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 
@@ -572,6 +579,7 @@ static PHP_INI_MH(OnUpdateSerializer) /* {{{ */
 {
 	const ps_serializer *tmp;
 
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 
@@ -600,6 +608,7 @@ static PHP_INI_MH(OnUpdateSerializer) /* {{{ */
 
 static PHP_INI_MH(OnUpdateTransSid) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 
@@ -616,6 +625,7 @@ static PHP_INI_MH(OnUpdateTransSid) /* {{{ */
 
 static PHP_INI_MH(OnUpdateSaveDir) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 
@@ -650,6 +660,7 @@ static PHP_INI_MH(OnUpdateSaveDir) /* {{{ */
 
 static PHP_INI_MH(OnUpdateName) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 
@@ -677,6 +688,7 @@ static PHP_INI_MH(OnUpdateName) /* {{{ */
 
 static PHP_INI_MH(OnUpdateCookieLifetime) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 	if (atol(ZSTR_VAL(new_value)) < 0) {
@@ -690,6 +702,7 @@ static PHP_INI_MH(OnUpdateCookieLifetime) /* {{{ */
 
 static PHP_INI_MH(OnUpdateSessionLong) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 	return OnUpdateLong(entry, new_value, mh_arg1, mh_arg2, mh_arg3, stage);
@@ -699,6 +712,7 @@ static PHP_INI_MH(OnUpdateSessionLong) /* {{{ */
 
 static PHP_INI_MH(OnUpdateSessionString) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 	return OnUpdateString(entry, new_value, mh_arg1, mh_arg2, mh_arg3, stage);
@@ -706,9 +720,18 @@ static PHP_INI_MH(OnUpdateSessionString) /* {{{ */
 /* }}} */
 
 
+static PHP_INI_MH(OnUpdateSessionCookieSameSite) /* {{{ */
+{
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
+	return OnUpdateString(entry, new_value, mh_arg1, mh_arg2, mh_arg3, stage);
+}
+/* }}} */
+
+
 static PHP_INI_MH(OnUpdateSessionBool) /* {{{ */
 {
 	SESSION_CHECK_OUTPUT_STATE;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	return OnUpdateBool(entry, new_value, mh_arg1, mh_arg2, mh_arg3, stage);
 }
@@ -721,6 +744,7 @@ static PHP_INI_MH(OnUpdateSidLength) /* {{{ */
 	char *endptr = NULL;
 
 	SESSION_CHECK_OUTPUT_STATE;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	val = ZEND_STRTOL(ZSTR_VAL(new_value), &endptr, 10);
 	if (endptr && (*endptr == '\0')
@@ -741,6 +765,7 @@ static PHP_INI_MH(OnUpdateSidBits) /* {{{ */
 	char *endptr = NULL;
 
 	SESSION_CHECK_OUTPUT_STATE;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	val = ZEND_STRTOL(ZSTR_VAL(new_value), &endptr, 10);
 	if (endptr && (*endptr == '\0')
@@ -758,6 +783,7 @@ static PHP_INI_MH(OnUpdateSidBits) /* {{{ */
 
 static PHP_INI_MH(OnUpdateLazyWrite) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 	SESSION_CHECK_OUTPUT_STATE;
 	return OnUpdateBool(entry, new_value, mh_arg1, mh_arg2, mh_arg3, stage);
@@ -802,7 +828,7 @@ PHP_INI_BEGIN()
 	STD_PHP_INI_ENTRY("session.cookie_domain",      "",          PHP_INI_ALL, OnUpdateSessionString, cookie_domain,      php_ps_globals,    ps_globals)
 	STD_PHP_INI_ENTRY("session.cookie_secure",      "0",         PHP_INI_ALL, OnUpdateSessionBool,   cookie_secure,      php_ps_globals,    ps_globals)
 	STD_PHP_INI_ENTRY("session.cookie_httponly",    "0",         PHP_INI_ALL, OnUpdateSessionBool,   cookie_httponly,    php_ps_globals,    ps_globals)
-	STD_PHP_INI_ENTRY("session.cookie_samesite",    "",          PHP_INI_ALL, OnUpdateString,        cookie_samesite,    php_ps_globals,    ps_globals)
+	STD_PHP_INI_ENTRY("session.cookie_samesite",    "",          PHP_INI_ALL, OnUpdateSessionCookieSameSite, cookie_samesite, php_ps_globals, ps_globals)
 	STD_PHP_INI_ENTRY("session.use_cookies",        "1",         PHP_INI_ALL, OnUpdateSessionBool,   use_cookies,        php_ps_globals,    ps_globals)
 	STD_PHP_INI_ENTRY("session.use_only_cookies",   "1",         PHP_INI_ALL, OnUpdateSessionBool,   use_only_cookies,   php_ps_globals,    ps_globals)
 	STD_PHP_INI_ENTRY("session.use_strict_mode",    "0",         PHP_INI_ALL, OnUpdateSessionBool,   use_strict_mode,    php_ps_globals,    ps_globals)
@@ -3161,7 +3187,7 @@ static int php_session_rfc1867_callback(unsigned int event, void *event_data, vo
 	if (php_session_rfc1867_orig_callback) {
 		retval = php_session_rfc1867_orig_callback(event, event_data, extra);
 	}
-	if (!PS(rfc1867_enabled) || true) {
+	if (!PS(rfc1867_enabled) || 1) {
 		return retval;
 	}
 
diff --git a/ext/session/tests/session_cookie_samesite_active.phpt b/ext/session/tests/session_cookie_samesite_active.phpt
new file mode 100644
index 0000000000..881d8376ed
--- /dev/null
+++ b/ext/session/tests/session_cookie_samesite_active.phpt
@@ -0,0 +1,15 @@
+--TEST--
+session.cookie_samesite can be changed during an active session when upload progress is disabled
+--INI--
+session.upload_progress.enabled=0
+session.use_cookies=0
+--FILE--
+<?php
+session_start();
+var_dump(ini_set('session.cookie_samesite', 'Lax'));
+var_dump(ini_get('session.cookie_samesite'));
+session_write_close();
+?>
+--EXPECT--
+string(0) ""
+string(3) "Lax"
diff --git a/ext/session/tests/session_cookie_samesite_upload_progress.phpt b/ext/session/tests/session_cookie_samesite_upload_progress.phpt
new file mode 100644
index 0000000000..795b1dd1e5
--- /dev/null
+++ b/ext/session/tests/session_cookie_samesite_upload_progress.phpt
@@ -0,0 +1,17 @@
+--TEST--
+session.cookie_samesite remains protected while upload progress is enabled
+--INI--
+session.upload_progress.enabled=1
+--FILE--
+<?php
+try {
+    ini_set('session.cookie_samesite', 'Lax');
+    echo "unexpected success\n";
+} catch (Error $e) {
+    echo "rejected\n";
+}
+var_dump(ini_get('session.cookie_samesite'));
+?>
+--EXPECT--
+rejected
+string(0) ""
