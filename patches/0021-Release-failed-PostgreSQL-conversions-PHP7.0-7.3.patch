From 266a147ea0e1b451a6dacc662453858999f1e981 Mon Sep 17 00:00:00 2001
From: Shivam Mathur <shivam_jpr@hotmail.com>
Date: Tue, 24 Nov 2026 15:37:01 +0530
Subject: [PATCH] Release the PostgreSQL conversion buffer when escaping fails


diff --git a/ext/pgsql/pgsql.c b/ext/pgsql/pgsql.c
index 15b7744f06..68494c5a66 100644
--- a/ext/pgsql/pgsql.c
+++ b/ext/pgsql/pgsql.c
@@ -6076,6 +6076,7 @@ PHP_PGSQL_API int php_pgsql_convert(PGconn *pg_link, const char *table_name, con
 							str = zend_string_alloc(Z_STRLEN_P(val) * 2, 0);
 							ZSTR_LEN(str) = PQescapeStringConn(pg_link, ZSTR_VAL(str), Z_STRVAL_P(val), Z_STRLEN_P(val), &escape_err);
 							if (escape_err) {
+								zend_string_release(str);
 								err = 1;
 							} else {
 								str = zend_string_truncate(str, ZSTR_LEN(str), 0);
