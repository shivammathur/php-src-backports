--TEST--
GHSA-r977-prxv-hc43: Single byte overread with convert.quoted-printable-decode filter
--FILE--
<?php

$input_data = str_repeat('A', 8189) . "X=\r";

$stream = fopen('php://temp', 'r+');

fwrite($stream, $input_data);

rewind($stream);

stream_filter_append($stream, 'convert.quoted-printable-decode');

$filtered_data = stream_get_contents($stream);

var_dump($filtered_data);

fclose($stream);

?>
--EXPECT--
string(8190) ""
